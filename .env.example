# Production persistence
DATABASE_URL="postgresql://vitcrm:CHANGE_ME@127.0.0.1:5432/vitcrm"
DATABASE_SSL="false"
NODE_ENV="production"

# GEMINI_API_KEY is optional. AI endpoints use a deterministic fallback when absent.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
