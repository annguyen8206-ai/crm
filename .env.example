# ============================================================================
# VitCRM — biến môi trường máy chủ (bắt buộc khi NODE_ENV=production)
# Sao chép file này thành .env rồi điền giá trị thật trên VPS.
# ============================================================================

# --- Kết nối PostgreSQL (BẮT BUỘC) ---------------------------------------------
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://vitcrm:CHANGE_ME@127.0.0.1:5432/vitcrm"

# Đặt "true" nếu PostgreSQL yêu cầu TLS (đa số DB managed: Neon/Supabase/RDS...).
# Nếu để sai, server sẽ báo lỗi kết nối lúc khởi động.
DATABASE_SSL="false"

# --- Môi trường --------------------------------------------------------------
NODE_ENV="production"

# --- Xác thực đăng nhập (BẮT BUỘC) ------------------------------------------
# Chuỗi ngẫu nhiên dài (>= 32 ký tự). Tạo nhanh:  openssl rand -hex 32
JWT_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Tài khoản quản trị được tạo tự động lần đầu khởi động (ghi vào bảng auth_users).
# Sau khi đăng nhập lần đầu, hãy đổi mật khẩu / tạo tài khoản khác trong mục Quản trị nhân sự.
AUTH_BOOTSTRAP_EMAIL="admin@example.com"
AUTH_BOOTSTRAP_PASSWORD="change-this-immediately"

# APP_URL: URL nơi ứng dụng được host (AI Studio tự inject khi chạy trên Cloud Run).
APP_URL="MY_APP_URL"

# ============================================================================
# TÍCH HỢP NGOÀI — tất cả đều TÙY CHỌN. Bỏ trống = chạy chế độ "giả lập"
# (app hoạt động bình thường, chỉ không gọi ra provider thật).
# Xem trạng thái: GET /api/health → .integrations  hoặc  GET /api/system/integrations
# ============================================================================

# --- AI (Gemini) ---
AI_ENABLED="false"
GEMINI_API_KEY=""

# --- Email / SMTP ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" nếu dùng cổng 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VitCRM <no-reply@your-domain.vn>"

# --- Zalo ZNS (Zalo OA Open API) ---
# Cách 1: dán access token, tự làm mới:
ZALO_OA_ACCESS_TOKEN=""
# Cách 2 (khuyến nghị): tự làm mới token:
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
# Map id template ZNS đã được Zalo duyệt:
ZNS_TEMPLATE_POST_VISIT_CARE=""
ZNS_TEMPLATE_AUTO_RECALL=""
ZNS_TEMPLATE_APPOINTMENT_CONFIRMED=""
ZNS_TEMPLATE_HEALTH_FOLLOWUP=""
# Template ZNS loại "OTP / Xác thực" đã được Zalo duyệt (để gửi mã OTP qua Zalo OA):
ZNS_TEMPLATE_OTP=""
ZNS_OTP_PARAM="otp"          # tên tham số chứa mã trong template ZNS (mặc định "otp")

# --- SMS / OTP ---
# Thứ tự kênh gửi OTP: thử lần lượt tới khi 1 kênh gửi thật thành công.
# zalo = ZNS OTP (cần ZALO_OA_* + ZNS_TEMPLATE_OTP) · sms = gateway SMS · email = khi có email
OTP_CHANNEL_ORDER="zalo,sms,email"
SMS_PROVIDER=""              # twilio | esms | generic
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME=""
SMS_WEBHOOK_URL=""           # provider "generic": POST {to, message}
SMS_WEBHOOK_TOKEN=""
OTP_TTL_SECONDS="300"
OTP_LENGTH="6"
OTP_DEV_ECHO="false"         # "true" chỉ khi dev: trả mã OTP trong response

# --- VoIP (click-to-call) ---
VOIP_PROVIDER=""             # stringee | generic
STRINGEE_API_KEY_SID=""
STRINGEE_API_KEY_SECRET=""
STRINGEE_FROM_NUMBER=""
STRINGEE_ANSWER_URL=""
VOIP_WEBHOOK_URL=""          # provider "generic": POST {from, to, agentId}
VOIP_WEBHOOK_TOKEN=""

# --- Tin nhắn đa kênh: Zalo OA (dùng chung khóa Zalo ở trên) + Facebook ---
# Zalo: cần thêm ZALO_APP_ID + ZALO_APP_SECRET (ở mục ZNS) để xác thực webhook,
#       và cấu hình Webhook URL trong Zalo OA: https://<domain>/api/webhooks/zalo
FACEBOOK_APP_SECRET=""             # xác thực chữ ký webhook (X-Hub-Signature-256)
FACEBOOK_PAGE_ACCESS_TOKEN=""      # gửi trả lời qua Send API
FACEBOOK_VERIFY_TOKEN=""           # chuỗi tự đặt, khớp khi verify webhook GET
# Webhook URL khai báo trong Meta App: https://<domain>/api/webhooks/facebook

# --- Dữ liệu demo ---
SEED_DEMO_DATA="false"             # "true" để giữ dữ liệu mẫu; mặc định CRM khởi tạo rỗng

# --- Nhắc lịch khám tự động (quét mỗi 5 phút, gửi ZNS→SMS lúc ~24h và ~2h) ---
REMINDER_ENABLED="false"          # "true" để bật scheduler

# --- Tổng đài: webhook cuộc gọi đến (screen-pop) ---
VOIP_WEBHOOK_SECRET=""            # bên PBX gửi kèm Authorization: Bearer <secret> tới POST /api/webhooks/voip

# --- Cổng khách hàng (Patient Portal) ---
# Đăng nhập bằng OTP theo số điện thoại đã có hồ sơ; dùng chung cấu hình SMS/OTP ở trên.
# APP_URL nên trỏ đúng domain để mã QR số thứ tự (POST /api/appointments/:id/checkin) tra cứu được.
PORTAL_TOKEN_TTL="12h"            # hạn phiên mặc định
PORTAL_REMEMBER_TTL="30d"         # hạn phiên khi bệnh nhân tick "Ghi nhớ 30 ngày"

# --- Mã hóa khóa bí mật nhập từ giao diện (bảng app_settings) ---
# 64 ký tự hex: openssl rand -hex 32 . Bỏ trống = suy ra từ JWT_SECRET.
# LƯU Ý: đổi khóa này (hoặc JWT_SECRET) sau khi đã lưu secret → phải nhập lại secret.
SETTINGS_ENC_KEY=""

# --- Thanh toán / đối soát VietQR ---
VIETQR_BANK_CODE="MB"
VIETQR_ACCOUNT_NUMBER=""
VIETQR_ACCOUNT_NAME=""
PAYMENT_PROVIDER=""          # casso | sepay | generic  (gợi ý dạng payload webhook)
PAYMENT_WEBHOOK_SECRET=""    # bên gửi phải kèm: Authorization: Bearer <secret>  (hoặc ?secret=)
