# ============================================================================
# VitCRM — biến môi trường máy chủ (bắt buộc khi NODE_ENV=production)
# Sao chép file này thành .env rồi điền giá trị thật trên VPS.
# ============================================================================

# --- Kết nối PostgreSQL (BẮT BUỘC) ---------------------------------------------
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://vitcrm:CHANGE_ME@127.0.0.1:5432/vitcrm"

# Đặt "true" nếu PostgreSQL yêu cầu TLS (đa số DB managed: Neon/Supabase/RDS...).
# Nếu để sai, server sẽ báo lỗi kết nối lúc khởi động.
DATABASE_SSL="false"

# --- Môi trường --------------------------------------------------------------
NODE_ENV="production"

# --- Xác thực đăng nhập (BẮT BUỘC) ------------------------------------------
# Chuỗi ngẫu nhiên dài (>= 32 ký tự). Tạo nhanh:  openssl rand -hex 32
JWT_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Tài khoản quản trị được tạo tự động lần đầu khởi động (ghi vào bảng auth_users).
# Sau khi đăng nhập lần đầu, hãy đổi mật khẩu / tạo tài khoản khác trong mục Quản trị nhân sự.
AUTH_BOOTSTRAP_EMAIL="admin@example.com"
AUTH_BOOTSTRAP_PASSWORD="change-this-immediately"

# --- AI (tùy chọn) ---------------------------------------------------------
AI_ENABLED="false"
# GEMINI_API_KEY không bắt buộc. Khi trống, các endpoint AI dùng fallback tất định.
GEMINI_API_KEY=""

# APP_URL: URL nơi ứng dụng được host (AI Studio tự inject khi chạy trên Cloud Run).
APP_URL="MY_APP_URL"
