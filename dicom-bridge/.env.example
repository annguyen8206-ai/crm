# --- VitCRM (cloud) ---
VITCRM_BASE_URL="https://crm.vitaliahmd.com"
DICOM_BRIDGE_SECRET=""            # phải giống hệt giá trị nhập trong VitCRM (Cấu Hình Tích Hợp -> DICOM)
POLL_INTERVAL_SECONDS="30"

# --- Orthanc ---
ORTHANC_HTTP_PORT="8042"
ORTHANC_DICOM_PORT="4242"
ORTHANC_AET="VITCRM_ORTHANC"       # AE Title Orthanc — đặt trên máy siêu âm làm đích worklist/storage
ORTHANC_HTTP_USER="admin"
ORTHANC_HTTP_PASSWORD=""           # đặt mật khẩu mạnh, đừng để trống khi expose ra ngoài LAN
WORKLIST_DIR="./worklists"         # thư mục Orthanc Worklist plugin đọc file .wl

# --- Máy siêu âm (điền theo tài liệu máy) ---
MODALITY_AET="ULTRASOUND1"
MODALITY_IP="192.168.1.50"
MODALITY_PORT="104"
